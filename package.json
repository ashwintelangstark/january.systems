{
  "name": "january-ai",
  "version": "1.0.0",
  "private": true,
  "description": "January - Local Autonomous AI Agent with Gemini & Claude",
  "scripts": {
    "dev": "npm run dev --prefix server",
    "start": "npm run dev --prefix server",
    "cli": "npm run cli --prefix server",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build:all": "npm run build --prefix server && npm run build --prefix client",
    "build:dmg": "npm run build:dmg --prefix JAN_APP",
    "build:app": "npm run build:dmg --prefix JAN_APP",
    "app": "npm start --prefix JAN_APP",
    "app:dev": "npm run dev --prefix JAN_APP"
  }
}
